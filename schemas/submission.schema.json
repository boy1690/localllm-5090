{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "localllm-5090 distilled submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "completed_date",
    "submitter_slug",
    "system",
    "runtime",
    "model",
    "suite_id",
    "evaluation",
    "results",
    "limitations",
    "license_accepted"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "submission_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}--[a-z0-9][a-z0-9-]{1,63}$" },
    "completed_date": { "type": "string", "format": "date" },
    "submitter_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "gpu_name", "gpu_count", "dedicated_vram_mib", "ram_mib"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "gpu_name": { "type": "string", "minLength": 1 },
        "gpu_count": { "type": "integer", "minimum": 1 },
        "dedicated_vram_mib": { "type": "integer", "minimum": 1 },
        "ram_mib": { "type": "integer", "minimum": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "backend"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "backend": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "filename", "quantization", "file_size_bytes"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "upstream_id": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "quantization": { "type": "string", "minLength": 1 },
        "file_size_bytes": { "type": "integer", "minimum": 1 },
        "file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "suite_id": { "type": "string", "minLength": 1 },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_tokens", "max_output_tokens", "seed", "gpu_offload", "flash_attention"],
      "properties": {
        "context_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" },
        "gpu_offload": { "type": "string", "minLength": 1 },
        "flash_attention": { "type": "boolean" }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "value", "unit", "status", "gate"],
        "properties": {
          "metric": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,63}$" },
          "value": { "type": ["number", "integer", "string", "null"] },
          "unit": { "type": "string" },
          "status": { "enum": ["pass", "fail", "measured", "not_run", "error"] },
          "gate": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "license_accepted": { "const": true }
  }
}
